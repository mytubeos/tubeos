# ==================== SERVER ====================
PORT=8080
NODE_ENV=development

# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tubeos

# ==================== JWT ====================
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ==================== REDIS ====================
# Local: redis://localhost:6379
# Upstash: rediss://default:password@host.upstash.io:6380
REDIS_URL=redis://localhost:6379

# ==================== CORS ====================
CLIENT_URL=http://localhost:3000
# Optional — comma-separated extra allowed origins (staging frontend, alternate
# local dev port, etc). If unset: defaults to the Vite/CRA dev ports in
# development (http://localhost:3000,http://localhost:5173), and to nothing
# extra in production. Set to an empty string to disable the dev defaults.
# CORS_EXTRA_ORIGINS=http://localhost:3000,http://localhost:5173
# Vercel sets VERCEL_URL automatically on their platform — no action needed.
# Set FRONTEND_URL only if you deploy the frontend somewhere Vercel-detection
# and CLIENT_URL/CORS_EXTRA_ORIGINS don't already cover.
# FRONTEND_URL=https://your-frontend-domain.com

# ==================== YOUTUBE OAUTH ====================
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/youtube/callback

# YouTube Data API v3 key (no OAuth) — required for the Trend Opportunity
# Scanner (growth.service.js: mostPopular chart lookup). Without this,
# Trends always falls back to a static curated list.
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_key

# ==================== GOOGLE CLOUD STORAGE (video staging) ====================
# Videos are streamed to GCS instead of being buffered in RAM, then streamed
# from GCS to YouTube. If GCS_BUCKET is unset, uploads fall back to in-memory
# storage (fine for local dev, NOT for production — large files can OOM).
GCS_BUCKET=your-gcs-bucket-name
GCS_PROJECT_ID=your-gcp-project-id
# On Cloud Run/GCE, Application Default Credentials are used automatically.
# Locally, point this at a service-account key JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==================== CLOUDINARY (thumbnail images) ====================
# Optional — powers both manual thumbnail uploads (video edit page) and the
# AI Thumbnail Generator (ai/thumbnail/generate). Without this, both return
# a 503 "Cloudinary not configured" error but the rest of the app works fine.
# Get free credentials at: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================== CLOUDFLARE WORKERS AI (thumbnail image generation) ====================
# Optional — powers the AI Thumbnail Generator's actual image generation
# (FLUX Schnell). Without this, ai/thumbnail/generate returns a 500. Free
# tier has a real daily allocation, no card required to start.
# Account ID: right sidebar of any page at https://dash.cloudflare.com
# API Token: My Profile > API Tokens > Create Token > "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ==================== EMAIL (Brevo) ====================
# Optional — if not set, emails are skipped and users auto-verified
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ==================== AI APIs ====================
# Optional — required for AI features
# GEMINI_API_KEY powers the Free plan (gemini-2.5-flash-lite) and thumbnail
# vision analysis for every plan (DeepSeek's public API has no reliable
# vision support). ANTHROPIC_API_KEY is no longer routed to by default (see
# DEEPSEEK_API_KEY below) — kept available as a manual fallback only.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
# Groq — free tier, used for Agency bulk-reply generation (llama-3.3-70b-versatile)
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_...
# DeepSeek — paid-plan text generation (titles/tags/description/content ideas/
# comment replies/sentiment on deepseek-v4-flash; shorts scripts/channel audit
# on deepseek-v4-pro). ~15-20x cheaper than the Claude models it replaces.
# Get a free-credit key (no card required to start) at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
# AI_TEST_MODE=true → sab plans free model use karenge (testing ke liye, Groq/Gemini)
# AI_TEST_MODE=false → production model routing (DeepSeek/Gemini/Groq)
AI_TEST_MODE=false

# ==================== SENTRY (error monitoring) ====================
# Optional — if unset, error tracking is disabled and the app runs normally.
# Get a DSN at https://sentry.io (Node/Express project).
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ==================== RAZORPAY ====================
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret — set in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ==================== STRIPE (alternate checkout, optional) ====================
# Fallback processor for users whose card doesn't work on Razorpay — same INR
# amounts, not a separate pricing tier. If STRIPE_SECRET_KEY is unset, the
# "pay another way" option is simply hidden and everything else works as normal.
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# Webhook secret — set in Stripe Dashboard > Developers > Webhooks, endpoint
# POST {BACKEND_URL}/api/v1/payment/stripe/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ==================== DODO PAYMENTS (primary checkout, USD-only) ====================
# Merchant of Record — the primary Upgrade button routes here. Chosen over a
# direct Stripe account because Stripe is invite-only for new India-based
# businesses; Dodo signs up from India today and handles per-country sales-tax
# compliance for us. If DODO_PAYMENTS_API_KEY is unset, checkout returns a
# clean 503 and the rest of the app works as normal.
# Get keys from https://app.dodopayments.com (Developer > API Keys)
DODO_PAYMENTS_API_KEY=your_dodo_api_key
# 'live' or 'test' (default) — test talks to test.dodopayments.com so local/
# staging never touches a real card.
DODO_MODE=test
# Webhook secret — set in Dodo Dashboard > Developer > Webhooks, endpoint
# POST {BACKEND_URL}/api/v1/payment/dodo/webhook, event payment.succeeded
DODO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# One product per plan, created in the Dodo dashboard as a one-time
# Pay-What-You-Want product (Pricing Type: Single Payment, PWYW enabled,
# Minimum Price: $1) — the actual charge amount is overridden per checkout
# from the admin-editable price in /admin/pricing, these IDs just anchor
# which product line-item Dodo attributes the sale to.
DODO_PRODUCT_ID_CREATOR=prod_xxxxxxxxxxxx
DODO_PRODUCT_ID_PRO=prod_xxxxxxxxxxxx
DODO_PRODUCT_ID_MAX=prod_xxxxxxxxxxxx

# ==================== YOUTUBE WEBHOOKS (PubSubHubbub) ====================
# BACKEND_URL: public URL of this server — required for YouTube to call our webhook.
# Set this to your Render deploy URL (e.g. https://tubeos-api.onrender.com).
# If unset, webhook subscriptions are silently skipped (safe for local dev).
BACKEND_URL=https://your-backend.onrender.com
# Optional secret token — YouTube sends this back on challenge so we can verify
# the request is from the hub and not a random POST.
# Generate any random string: openssl rand -hex 32
WEBHOOK_VERIFY_TOKEN=your_random_secret_token

# ==================== RATE LIMITS (Optional) ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
